create extension if not exists pgcrypto;

create table if not exists public.profiles (
  id uuid primary key references auth.users(id) on delete cascade,
  email text unique,
  display_name text,
  role text not null default 'member' check (role in ('member','admin')),
  active boolean not null default true,
  created_at timestamptz not null default now()
);

create table if not exists public.shifts (
  id uuid primary key default gen_random_uuid(),
  title text not null check (length(trim(title)) between 1 and 80),
  shift_date date not null,
  start_time time not null,
  end_time time not null,
  location text not null default '',
  notes text not null default '',
  capacity integer not null default 4 check (capacity = 4),
  created_by uuid references public.profiles(id),
  created_at timestamptz not null default now(),
  check (end_time > start_time)
);

create table if not exists public.shift_assignments (
  shift_id uuid not null references public.shifts(id) on delete cascade,
  user_id uuid not null references public.profiles(id) on delete cascade,
  created_at timestamptz not null default now(),
  primary key (shift_id,user_id)
);

-- Profiles are created automatically for invited/new auth users; they always start as members.
create or replace function public.handle_new_user()
returns trigger language plpgsql security definer set search_path = public
as $$
begin
  insert into public.profiles(id,email,display_name,role,active)
  values (new.id,new.email,coalesce(new.raw_user_meta_data->>'display_name',''), 'member', true)
  on conflict (id) do update set email=excluded.email;
  return new;
end; $$;

drop trigger if exists on_auth_user_created_profile on auth.users;
create trigger on_auth_user_created_profile after insert on auth.users
for each row execute procedure public.handle_new_user();

create or replace function public.is_admin()
returns boolean language sql stable security definer set search_path = public
as $$
  select exists(select 1 from public.profiles where id=auth.uid() and role='admin' and active=true);
$$;

alter table public.profiles enable row level security;
alter table public.shifts enable row level security;
alter table public.shift_assignments enable row level security;

drop policy if exists "active members read profiles" on public.profiles;
create policy "active members read profiles" on public.profiles
for select to authenticated using (
  active=true and exists(select 1 from public.profiles me where me.id=auth.uid() and me.active=true)
);

drop policy if exists "users update own display name" on public.profiles;
create policy "users update own display name" on public.profiles
for update to authenticated using (id=auth.uid()) with check (id=auth.uid() and role=(select p.role from public.profiles p where p.id=auth.uid()) and active=(select p.active from public.profiles p where p.id=auth.uid()));

drop policy if exists "active members read shifts" on public.shifts;
create policy "active members read shifts" on public.shifts
for select to authenticated using (exists(select 1 from public.profiles p where p.id=auth.uid() and p.active=true));

drop policy if exists "admins create shifts" on public.shifts;
create policy "admins create shifts" on public.shifts
for insert to authenticated with check (public.is_admin() and created_by is null or public.is_admin());

drop policy if exists "admins update shifts" on public.shifts;
create policy "admins update shifts" on public.shifts
for update to authenticated using (public.is_admin()) with check (public.is_admin() and capacity=4);

drop policy if exists "admins delete shifts" on public.shifts;
create policy "admins delete shifts" on public.shifts
for delete to authenticated using (public.is_admin());

drop policy if exists "members read assignments" on public.shift_assignments;
create policy "members read assignments" on public.shift_assignments
for select to authenticated using (exists(select 1 from public.profiles p where p.id=auth.uid() and p.active=true));

drop policy if exists "admins assign members" on public.shift_assignments;
create policy "admins assign members" on public.shift_assignments
for insert to authenticated with check (public.is_admin());

drop policy if exists "admins remove assignments" on public.shift_assignments;
create policy "admins remove assignments" on public.shift_assignments
for delete to authenticated using (public.is_admin());

-- Signup is atomic and capacity is checked under a row lock to prevent a fifth person.
create or replace function public.sign_up_for_shift(p_shift_id uuid)
returns void language plpgsql security definer set search_path = public
as $$
declare
  v_capacity integer;
  v_active boolean;
  v_count integer;
begin
  select active into v_active from public.profiles where id=auth.uid();
  if coalesce(v_active,false)=false then raise exception 'Your account is inactive.'; end if;
  perform 1 from public.shifts where id=p_shift_id for update;
  if not found then raise exception 'Shift not found.'; end if;
  select capacity into v_capacity from public.shifts where id=p_shift_id;
  select count(*) into v_count from public.shift_assignments where shift_id=p_shift_id;
  if exists(select 1 from public.shift_assignments where shift_id=p_shift_id and user_id=auth.uid()) then
    raise exception 'You are already signed up for this shift.';
  end if;
  if v_count >= least(v_capacity,4) then raise exception 'This shift is full (maximum 4 people).'; end if;
  insert into public.shift_assignments(shift_id,user_id) values(p_shift_id,auth.uid());
end; $$;
revoke all on function public.sign_up_for_shift(uuid) from public;
grant execute on function public.sign_up_for_shift(uuid) to authenticated;

-- Keep roles/active flags from being changed through the ordinary profile update policy.
revoke update on public.profiles from authenticated;
grant update(display_name) on public.profiles to authenticated;

grant select on public.profiles,public.shifts,public.shift_assignments to authenticated;
grant insert,update,delete on public.shifts to authenticated;
grant insert,delete on public.shift_assignments to authenticated;

